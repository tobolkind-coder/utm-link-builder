server {
    listen 80;
    server_name ${SHORT_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${SHORT_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SHORT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SHORT_DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # $remote_addr, а не $proxy_add_x_forwarded_for: последний дописывает
        # реальный адрес к присланному клиентом, позволяя подделать первый элемент.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
